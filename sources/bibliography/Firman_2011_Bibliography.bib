% Experimental evolution study on postcopulatory sexual selection
% Key finding: 77% paternity monopolization by genetically superior males
% ============================================================================

@article{firman2011postcopulatory,
  author    = {Firman, Renée C. and Simmons, Leigh W.},
  title     = {Postcopulatory Sexual Selection Drives the Evolution of Male Investment in Sperm Competition},
  journal   = {BMC Evolutionary Biology},
  year      = {2011},
  volume    = {11},
  number    = {1},
  pages     = {1--9},
  month     = {December},
  doi       = {10.1186/1471-2148-11-356},
  pmid      = {22145631},
  pmcid     = {PMC3258245},
  url       = {https://bmcecolevol.biomedcentral.com/articles/10.1186/1471-2148-11-356},
  issn      = {1471-2148},
  publisher = {BioMed Central},
  abstract  = {Background: Postcopulatory sexual selection via sperm competition and cryptic female choice is increasingly recognized as an important evolutionary force shaping reproductive traits. However, few studies have examined how male investment in ejaculate components evolves under postcopulatory sexual selection. Results: Using experimental evolution, we show that male house mice (Mus musculus domesticus) exposed to increased sperm competition evolved to produce ejaculates with greater competitive ability. Males from selected lineages sired 77\% of offspring when in sperm competition with males from control lineages. Conclusions: Our findings provide experimental evidence that postcopulatory sexual selection is a powerful evolutionary force that can drive rapid changes in male reproductive traits related to sperm competitive ability.},
  keywords  = {postcopulatory sexual selection, sperm competition, experimental evolution, polyandry, cryptic female choice, male reproductive investment, sexy sons hypothesis, genetic benefits, Mus musculus, paternity bias},
  note      = {Experimental evolution study across 27 generations demonstrating 77\% paternity monopolization by males from lineages exposed to polyandrous mating conditions. Primary evidence for genetic benefits of female multiple mating through "sexy sons" mechanism.}
}

